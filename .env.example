# Configuração do Firebase — copie estes valores do Console do Firebase
# (Configurações do projeto > Geral > Seus apps > SDK setup and configuration).
#
# Nenhum destes valores é secreto no sentido de "senha" — são
# identificadores públicos do projeto Firebase — mas mesmo assim NÃO
# devem ficar hardcoded no código-fonte; use sempre variáveis de
# ambiente, tanto localmente (.env) quanto no Netlify (Site settings >
# Environment variables).
#
# Se estas variáveis não forem definidas, o site funciona normalmente em
# modo estático (sem horário dinâmico, sem admin, sem banco de dados),
# exatamente como funcionava antes desta funcionalidade existir.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
