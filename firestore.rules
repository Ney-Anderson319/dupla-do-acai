rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Produtos: qualquer visitante pode ler (é o cardápio público).
    // Só um administrador autenticado pode criar, editar ou excluir.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Configurações (ex: horário de funcionamento): leitura pública,
    // porque o site precisa saber se está aberto ou fechado. Escrita
    // só por admin autenticado.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Pedidos: qualquer cliente pode CRIAR um pedido (é o checkout
    // público), mas ninguém além de um admin autenticado pode ler,
    // listar, editar ou excluir pedidos existentes. Isso protege os
    // dados pessoais dos clientes.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
